# ╔═══════════════════════════════════════════════════════╗
# ║  PRODUCTION ENV TEMPLATE — SecurityNet.ai             ║
# ║  Set these in AWS Amplify Console → Env Variables     ║
# ║  DO NOT commit actual values to Git                   ║
# ╚═══════════════════════════════════════════════════════╝

# ── App ──
NEXT_PUBLIC_SETTING=live
NEXT_PUBLIC_APP_URL=https://<production-domain>

# ISO 8601 datetime the presale countdown (SaleTimer) counts down to.
# Falls back to 2027-01-01 if unset — set this to the real presale end date
# before launch so the countdown isn't showing a placeholder.
NEXT_PUBLIC_PRESALE_END_DATE=<presale-end-date e.g. 2026-12-31T00:00:00Z>

# ── NextAuth ──
NEXTAUTH_URL=https://<production-domain>
NEXTAUTH_SECRET=<generate: openssl rand -hex 32>

# ── MongoDB ──
MONGODB_URI=<production-atlas-connection-string>
MONGODB_DB=securitynet

# ── Blockchain (PRODUCTION ONLY — client provides these) ──
OWNER_PRIVATE_KEY=<client-provides-this>
XN_TOKEN_CONTRACT_ADDRESS=0x01c4D7E3FA846D9Ed293912118AdaC5B654344F0
NEXT_PUBLIC_XN_TOKEN_CONTRACT_ADDRESS=0x01c4D7E3FA846D9Ed293912118AdaC5B654344F0

# ── Deposit Wallets (PRODUCTION ONLY — client provides these) ──
# Single source of truth: these NEXT_PUBLIC_ vars are both displayed on the buy
# page AND used by the server to watch for incoming USDT. Set only these three.
NEXT_PUBLIC_DEPOSIT_WALLET_BSC=<client-provides-this>
NEXT_PUBLIC_DEPOSIT_WALLET_ETH=<client-provides-this>
NEXT_PUBLIC_DEPOSIT_WALLET_TRON=<client-provides-this>

# ── APIs ──
MORALIS_API_KEY=<moralis-api-key>
MORALIS_STREAM_SECRET=<generated-after-stream-setup>
TRONGRID_API_KEY=<trongrid-api-key>
ADMIN_SECRET=<generate: openssl rand -hex 24>

# ── Reown / WalletConnect ──
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=<reown-project-id>

# ── Groq (AI Agent) ──
GROQ_API_KEY=<groq-api-key>
# Optional override, defaults to llama-3.3-70b-versatile
# GROQ_MODEL=llama-3.3-70b-versatile

# ── AWS S3 ──
NEXT_S3_REGION=us-east-1
NEXT_S3_ACCESS_KEY=<aws-iam-access-key>
NEXT_S3_SECRET_KEY=<aws-iam-secret-key>

# ── AWS DynamoDB / SES ──
NEXT_AWS_REGION=us-east-1
NEXT_AWS_ACCESS_KEY=<aws-iam-access-key>
NEXT_AWS_SECRET_ACCESS_KEY=<aws-iam-secret-key>

# ── AWS SES verified sender ──
# Verify your sender email in AWS SES before going live
